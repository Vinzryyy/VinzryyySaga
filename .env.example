# X API v2 auto-sync
X_BEARER_TOKEN=your_x_bearer_token
X_USERNAME=armeniaca15
X_SYNC_MAX_PAGES=3
X_SYNC_PAGE_SIZE=100

# Optional monitoring endpoint
# VITE_MONITORING_ENDPOINT=https://your-monitoring-endpoint

# Firebase web app config — values from Firebase console → Project Settings → Web app.
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored
# via `*.local`, so the live values never touch the repo.
#
# These are NOT secrets in the traditional sense — Firebase web API keys ship in the
# client bundle. Security comes from Realtime Database rules, not from key obscurity.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# OpenRouter (free Kimi K2.6) — powers:
#   - Aider CLI (local dev, reads from .env.local)
#   - /api/arme-chat fallback when Gemini is unavailable
# Set in Vercel → Project Settings → Environment Variables for production.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google AI Studio (Gemini 2.0 Flash) — primary backend for /api/arme-chat.
# Free tier: 15 RPM / 1500 RPD personal quota (per-key, not shared).
# Set in Vercel → Project Settings → Environment Variables for production.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
